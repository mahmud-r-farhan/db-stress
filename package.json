{
  "name": "db-stress-cli",
  "version": "1.0.0",
  "description": "A CLI tool for stress testing databases or APIs with dummy data",
  "main": "dist/cli.js",
  "bin": {
    "db-stress": "dist/db-stress-cli.js"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.js",
    "start": "node dist/db-stress-cli.js"
  },
  "keywords": [
    "cli",
    "database",
    "stress-test",
    "mongodb",
    "postgresql",
    "mysql",
    "api"
  ],
  "author": "Mahmud Rahman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahmud-r-farhan/db-stress-cli.git"
  },
  "files": [
    "dist",
    "readme.md"
  ],
"dependencies": {
  "@faker-js/faker": "^9.0.1",
  "axios": "^1.7.7",
  "chalk": "^5.3.0",
  "commander": "^12.1.0",
  "inquirer": "^10.1.8",
  "mongodb": "^6.9.0",
  "mysql2": "^3.15.3",
  "p-queue": "^8.0.1",
  "pg": "^8.12.0",
  "zod": "^3.23.8"
},
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rollup": "^4.21.3"
  },
  "type": "module"
}
